# Pulled automatically after linking + adding Upstash Redis to the Vercel project:
#   vercel link --yes --scope adrevnview1 --project wake-up-barber
#   vercel env pull .env.local --yes
#
# Either pair works (Vercel KV Marketplace / Upstash):
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Long random string used to sign admin session cookies (recommended in production):
SESSION_SECRET=

# Optional explicit origin for CORS (defaults to request host):
# APP_ORIGIN=https://wake-up-barber.vercel.app
